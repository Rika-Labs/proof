{
  "name": "@rikalabs/proof",
  "version": "0.5.1",
  "description": "Plain-english rules for PRs and code review, judged by Jev. Local-first MCP — bring your own TYPESAFE_API_KEY.",
  "license": "MIT",
  "author": "Rika Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rika-Labs/proof.git"
  },
  "bin": {
    "proof": "./src/cli.ts"
  },
  "files": [
    "src",
    ".amp/plugins/proof",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "check": "bun run typecheck && bun run lint && bun run test && bun run format:check",
    "start": "bun src/cli.ts mcp"
  },
  "dependencies": {
    "@distilled.cloud/github": "1.0.0-rc.12",
    "@effect/ai-typesafe": "4.0.0-rc.116",
    "@effect/platform-node": "4.0.0-rc.116",
    "@effect/platform-node-shared": "4.0.0-rc.116",
    "@rikalabs/distilled-typesafe": "1.0.0-rc.7",
    "effect": "4.0.0-rc.116"
  },
  "devDependencies": {
    "@ampcode/plugin": "0.0.0-20260919001729-g2c73376",
    "@effect/vitest": "4.0.0-rc.116",
    "@types/node": "24.12.2",
    "bun-types": "^1.4.2",
    "oxfmt": "0.66.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.116"
  },
  "engines": {
    "bun": ">=1.2",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2"
}
