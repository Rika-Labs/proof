{
  "name": "@rikalabs/proof",
  "version": "0.2.0",
  "description": "Plain-english rules for PRs and code review, judged by Jev. Local-first MCP — bring your own TYPESAFE_API_KEY.",
  "license": "MIT",
  "author": "Rika Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rika-Labs/proof.git"
  },
  "bin": {
    "cli": "./src/cli.ts",
    "mcp": "./src/server.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "check": "bun run typecheck && bun run lint && bun run test && bun run format:check",
    "start": "bun src/server.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.115",
    "@types/node": "24.12.2",
    "bun-types": "^1.4.2",
    "oxfmt": "0.66.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.115"
  },
  "engines": {
    "bun": ">=1.2",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2"
}
